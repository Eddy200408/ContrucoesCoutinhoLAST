# Copie para .env.local e preencha com os dados do painel do Cloudinary (Dashboard → API Keys)

# Público — usado pelo site para montar os URLs das imagens
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Pasta onde as imagens ficam guardadas no Cloudinary
NEXT_PUBLIC_CLOUDINARY_FOLDER=construcoes-coutinho

# Privado — usado APENAS pelo script de upload (npm run cloudinary:upload). Nunca publicar.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL público do site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_BASE_URL=https://construcoescoutinho.cv

# Código de verificação do Google Search Console (opcional — meta tag "google-site-verification")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
